Package: dsImagingClient
Type: Package
Title: DataSHIELD Client for Medical Imaging Datasets
Version: 0.1.0
Authors@R:
    c(person("David", "Sarrat Gonz\u00e1lez", , "david.sarrat@isglobal.org", role = c("aut", "cre")),
